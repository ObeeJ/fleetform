AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=us-east-1
# Required to actually call RunInstances / TerminateInstances
FLEETFORM_LIVE=1
# Optional override instead of resolving Amazon Linux 2023
# FLEETFORM_AMI=ami-xxxxxxxxxxxxxxxx
# FLEETFORM_S3_BUCKET=fleetform-state
# FLEETFORM_UI=1
CONSUL_ENDPOINT=http://localhost:8500
